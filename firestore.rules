rules_version = '2';

// 勤怠タイムカードのアクセス権限
// ・オーナー（OWNER_EMAIL）は常に管理者
// ・新しくログインした人は「承認待ち」。管理者が承認すると打刻できる
// ・従業員は自分の記録だけ読み書きできる。退勤済みの日は変更・削除できない（修正依頼を送る）
// ・管理者は全員の記録を読み書きできる
service cloud.firestore {
  match /databases/{database}/documents {

    // ↓ public/firebase-config.js の ownerEmail と同じ値にしてください
    function ownerEmail() { return 't.kohiyama@veiqu.co.jp'; }

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == ownerEmail().lower()
        && request.auth.token.email_verified == true;
    }
    function me() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function hasMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function isActive() { return isOwner() || (hasMember() && me().status == 'active'); }
    function isAdmin() { return isOwner() || (hasMember() && me().status == 'active' && me().role == 'admin'); }

    // ---- 従業員名簿 ----
    match /members/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // 初回ログイン時に自分の行を作る。オーナー以外は「従業員・承認待ち」でしか作れない
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (
          (request.resource.data.role == 'staff' && request.resource.data.status == 'pending')
          || (isOwner() && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
        );
      // 本人が変えられるのは名前だけ。役割・状態は管理者だけ
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 40);
      allow delete: if isAdmin();
    }

    // ---- 設定（所定労働時間・残業上限） ----
    match /settings/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- 勤怠（1日1件） ----
    function closed(d) { return d.get('out', '') != ''; }
    function validDay(uid, date) {
      let d = request.resource.data;
      return d.uid == uid
        && d.date == date
        && d.ym == date[0:7]
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.updatedAt == request.time
        && d.keys().hasOnly(['uid', 'date', 'ym', 'type', 'in', 'out', 'breakMin', 'note', 'direct', 'straight', 'inAt', 'outAt', 'updatedAt']);
    }
    match /attendance/{uid}/days/{date} {
      allow read: if (isSelf(uid) && isActive()) || isAdmin();
      allow create: if isAdmin() || (isSelf(uid) && isActive() && validDay(uid, date));
      // 退勤済みの日は、従業員は変更も削除もできない
      allow update: if isAdmin() || (isSelf(uid) && isActive() && !closed(resource.data) && validDay(uid, date));
      allow delete: if isAdmin() || (isSelf(uid) && isActive() && !closed(resource.data));
    }
    // 管理者が全員分をまとめて読む（collectionGroup）
    match /{path=**}/days/{date} {
      allow read: if isAdmin();
    }

    // ---- 有給の付与 ----
    match /grants/{uid} {
      allow read: if (isSelf(uid) && isActive()) || isAdmin();
      allow write: if isAdmin();
    }

    // ---- 修正依頼 ----
    match /requests/{rid} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
        && request.resource.data.keys().hasOnly(['uid', 'date', 'want', 'reason', 'status', 'createdAt']);
      // 本人は承認待ちの自分の依頼だけ取り消せる。承認・却下は管理者だけ
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
      allow update: if isAdmin();
    }
  }
}
